diff --git a/tests/src/Unit/Client/PhpRedisSentinelTest.php b/tests/src/Unit/Client/PhpRedisSentinelTest.php
new file mode 100644
index 0000000..dffa7c0
--- /dev/null
+++ b/tests/src/Unit/Client/PhpRedisSentinelTest.php
@@ -0,0 +1,123 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\redis\Unit\Client;
+
+use Drupal\Core\Site\Settings;
+use Drupal\redis\Client\PhpRedis;
+use Drupal\Tests\UnitTestCase;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RequiresPhpExtension;
+
+/**
+ * Tests the Sentinel master lookup of the PhpRedis client.
+ */
+#[CoversClass(PhpRedis::class)]
+#[Group('redis')]
+#[RequiresPhpExtension('redis')]
+class PhpRedisSentinelTest extends UnitTestCase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    new Settings([
+      'redis.connection' => [
+        'instance' => 'mymaster',
+      ],
+    ]);
+  }
+
+  /**
+   * Asks the given client for the master.
+   *
+   * @param \Redis $client
+   *   The client.
+   * @param string[] $sentinels
+   *   The sentinels.
+   *
+   * @return mixed
+   *   The return value of PhpRedis::askForMaster().
+   */
+  protected function askForMaster(\Redis $client, array $sentinels): mixed {
+    $method = new \ReflectionMethod(PhpRedis::class, 'askForMaster');
+    return $method->invoke(new PhpRedis(), $client, $sentinels);
+  }
+
+  /**
+   * Tests that the next sentinel is tried when connecting to one fails.
+   */
+  public function testConnectionTimeout(): void {
+    $client = $this->createMock(\Redis::class);
+    $client->expects($this->exactly(2))
+      ->method('connect')
+      ->willReturnCallback(function ($host, $port, $timeout): bool {
+        $this->assertSame(0.5, $timeout);
+        if ($host === 'sentinel-0') {
+          throw new \RedisException('Operation timed out');
+        }
+        return TRUE;
+      });
+    $client->method('isConnected')->willReturn(TRUE);
+    $client->expects($this->once())
+      ->method('rawcommand')
+      ->with('SENTINEL', 'get-master-addr-by-name', 'mymaster')
+      ->willReturn(['redis-1', '6379']);
+
+    $this->assertSame(['redis-1', '6379'], $this->askForMaster($client, ['sentinel-0:5000', 'sentinel-1:5000']));
+  }
+
+  /**
+   * Tests that the next sentinel is tried when a sentinel command fails.
+   */
+  public function testCommandFailure(): void {
+    $client = $this->createMock(\Redis::class);
+    $client->method('connect')->willReturn(TRUE);
+    $client->method('isConnected')->willReturn(TRUE);
+    $client->expects($this->exactly(2))
+      ->method('rawcommand')
+      ->willReturnOnConsecutiveCalls(
+        $this->throwException(new \RedisException('read error on connection')),
+        ['redis-1', '6379'],
+      );
+
+    $this->assertSame(['redis-1', '6379'], $this->askForMaster($client, ['sentinel-0:5000', 'sentinel-1:5000']));
+  }
+
+  /**
+   * Tests that NULL is returned when no sentinel can be reached.
+   */
+  public function testNoSentinelAvailable(): void {
+    $client = $this->createMock(\Redis::class);
+    $client->method('connect')->willThrowException(new \RedisException('Operation timed out'));
+    $client->expects($this->never())->method('rawcommand');
+
+    $this->assertNull($this->askForMaster($client, ['sentinel-0:5000', 'sentinel-1:5000']));
+  }
+
+  /**
+   * Tests the sentinel connection timeout setting.
+   */
+  public function testSentinelTimeout(): void {
+    new Settings([
+      'redis.connection' => [
+        'instance' => 'mymaster',
+        'sentinel_timeout' => 2,
+      ],
+    ]);
+    $client = $this->createMock(\Redis::class);
+    $client->expects($this->once())
+      ->method('connect')
+      ->with('sentinel-0', '5000', 2)
+      ->willReturn(TRUE);
+    $client->method('isConnected')->willReturn(TRUE);
+    $client->method('rawcommand')->willReturn(['redis-1', '6379']);
+
+    $this->assertSame(['redis-1', '6379'], $this->askForMaster($client, ['sentinel-0:5000']));
+  }
+
+}
